{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scheda",
  "version": "0.1.0",
  "identifier": "com.lacodda.scheda",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scheda",
        "width": 1000,
        "height": 700,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A markdown notepad with a lean towards the vault.",
    "longDescription": "scheda opens a markdown file before you notice the window, draws the markup over the source without hiding it, and saves back the exact bytes it read."
  }
}
