{
  "name": "scheda",
  "version": "0.1.0",
  "description": "A markdown notepad that turns into a vault when there is a folder around it.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit && pnpm test",
